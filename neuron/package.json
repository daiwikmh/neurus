    "@mysten/seal": "^1.1.3",
    "@mysten/sui": "^2.17.0",
    "@mysten/walrus": "^1.1.7",
    "jsdom": "^29.1.1",
    "mammoth": "^1.12.0",
    "tsx": "^4.19.0",
    "turndown": "^7.2.4",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
