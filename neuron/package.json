{
  "name": "neurus",
  "version": "0.1.0",
  "type": "module",
  "description": "Owned, verifiable memory layer for AI agents — on Walrus",
  "bin": {
    "neurus": "./dist/neurus.js",
    "neurus-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "cli": "tsx bin/neurus.ts",
    "neurus": "tsx bin/neurus.ts",
    "web": "tsx src/web/server.ts",
    "api": "tsx src/api/server.ts",
    "start": "tsx src/api/server.ts",
    "typecheck": "tsc --noEmit",
    "share": "tsx bin/share.ts",
    "mcp": "tsx bin/mcp.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@mysten-incubation/memwal": "^0.0.7",
    "@mysten/seal": "^1.1.3",
    "@mysten/sui": "^2.17.0",
    "@mysten/walrus": "^1.1.7",
    "jsdom": "^29.1.1",
    "mammoth": "^1.12.0",
    "tsx": "^4.19.0",
    "turndown": "^7.2.4",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  }
}
