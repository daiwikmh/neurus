  "keywords": [
    "ai",
    "memory",
    "agent",
    "cli",
    "walrus",
    "sui",
    "seal",
    "mcp",
    "llm",
    "rag"
  ],
  "homepage": "https://neurus.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daiwikmh/neurus.git",
    "directory": "neuron"
  },
  "bugs": "https://github.com/daiwikmh/neurus/issues",
  "license": "MIT",
  "author": "daiwikmh",
  "bin": {
    "neurus": "./dist/neurus.js",
    "neurus-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "cli": "tsx bin/neurus.ts",
    "neurus": "tsx bin/neurus.ts",
    "web": "tsx src/web/server.ts",
    "api": "tsx src/api/server.ts",
    "start": "tsx src/api/server.ts",
    "typecheck": "tsc --noEmit",
