{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@neurus/core": ["packages/core/src"],
      "@neurus/memory": ["packages/memory/src"],
      "@neurus/agents": ["packages/agents/src"],
      "@neurus/watchers": ["packages/watchers/src"],
      "@neurus/feature-engine": ["packages/feature-engine/src"],
      "@neurus/contradiction": ["packages/contradiction/src"]
    }
  }
}
